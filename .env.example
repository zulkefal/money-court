# YouTube Data API v3 — populated by running auth.py once locally.
# See pipeline/uploader.py and auth.py for the OAuth bootstrap flow.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# Facebook Graph API — used by pipeline/facebook_uploader.py to cross-post each
# rendered video as a Reel. Both must be set or FB upload is skipped silently.
# Generate a non-expiring Page Access Token via Meta Business Suite → System Users.
# Required app permissions: pages_manage_posts, pages_read_engagement, pages_show_list.
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=

# Instagram Business Account ID linked to FB_PAGE_ID. Reuses FB_PAGE_ACCESS_TOKEN
# (FB Login for Business path). Look up via Graph API Explorer:
#   GET /{FB_PAGE_ID}?fields=instagram_business_account
# App must have instagram_basic + instagram_content_publish + pages_read_engagement.
IG_USER_ID=

# Pipeline settings
OUTPUT_DIR=./outputs
LOG_LEVEL=INFO

# --- CI / Linux overrides (do NOT set on Mac dev machine) ---
# In GitHub Actions these come from the workflow `env:` block, not from .env.
# FFMPEG_BIN=ffmpeg
# FFPROBE_BIN=ffprobe
# CAPTION_FONT=/usr/share/fonts/truetype/liberation/LiberationSans-Bold.ttf

# --- GitHub Secrets needed for the daily.yml workflow ---
# Add these at: Settings → Secrets and variables → Actions → New repository secret
#   ANTHROPIC_API_KEY        (your Claude API key)
#   YOUTUBE_CLIENT_ID        (from auth.py output)
#   YOUTUBE_CLIENT_SECRET    (from auth.py output)
#   YOUTUBE_REFRESH_TOKEN    (from auth.py output)
#   FB_PAGE_ID               (Facebook Page numeric ID)
#   FB_PAGE_ACCESS_TOKEN     (long-lived Page Access Token from Meta Business Suite)
#   IG_USER_ID               (Instagram Business Account ID linked to the FB Page)
